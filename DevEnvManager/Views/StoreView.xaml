<UserControl x:Class="DevEnvManager.Views.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnvManager.ViewModels"
             xmlns:local="clr-namespace:DevEnvManager.Views"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolConverter x:Key="InverseBool" />
        <local:InverseBoolToVisConverter x:Key="InverseBoolToVis" />
        <local:InitialConverter x:Key="InitialConverter" />
        <local:ColorToBgConverter x:Key="ColorToBgConverter" />

        <!-- 软件卡片 -->
        <DataTemplate x:Key="StoreCard" DataType="{x:Type vm:StoreItem}">
            <Border Width="340" Margin="6" CornerRadius="12" Background="{StaticResource CardBrush}"
                    Padding="14,12" Effect="{StaticResource CardShadowSm}"
                    BorderBrush="#E8ECF1" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题行：图标 + 名称 + 状态 -->
                    <DockPanel Grid.Row="0">
                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="9"
                                Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name, Converter={StaticResource InitialConverter}}"
                                       FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200" />
                            <TextBlock Text="{Binding Id}" FontSize="10.5" Foreground="{StaticResource SubTextBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,3" VerticalAlignment="Center"
                                Background="{Binding StatusColor, Converter={StaticResource ColorToBgConverter}}">
                            <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                       Foreground="{Binding StatusColor}" FontWeight="SemiBold" />
                        </Border>
                    </DockPanel>

                    <!-- 版本 + 来源 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="版本: " FontSize="11" Foreground="{StaticResource SubTextBrush}" />
                        <TextBlock Text="{Binding Version}" FontSize="11" />
                        <TextBlock Text="   源: " FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Source}" FontSize="11" />
                    </StackPanel>

                    <!-- 占位 -->
                    <Grid Grid.Row="2" Height="8" />

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- 安装按钮（未安装时显示） -->
                        <Button Content="安装" Padding="16,6" Margin="4,0"
                                Style="{StaticResource PrimaryButton}" FontSize="12"
                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <!-- 更新按钮（可更新时显示） -->
                        <Button Content="更新" Padding="16,6" Margin="4,0"
                                Style="{StaticResource PrimaryButton}" FontSize="12"
                                Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <!-- 卸载按钮（已安装时显示） -->
                        <Button Content="卸载" Padding="16,6" Margin="4,0"
                                Style="{StaticResource SecondaryButton}" FontSize="12"
                                Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部搜索栏 -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="12"
                Padding="16,12" Margin="0,0,0,10" Effect="{StaticResource CardShadowSm}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Height="36" VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="输入软件名称搜索 winget 源（如 chrome、vscode、7zip）"
                         KeyDown="SearchBox_KeyDown" />
                <Button Grid.Column="1" Content="搜索" Padding="20,8" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" />
                <Button Grid.Column="2" Content="刷新状态" Padding="16,8" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Command="{Binding RefreshStatusCommand}" />
            </Grid>
        </Border>

        <!-- 搜索结果卡片网格 -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="12"
                Padding="10" Effect="{StaticResource CardShadowSm}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource StoreCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="12"
                Padding="14,8" Margin="0,10,0,0" Effect="{StaticResource CardShadowSm}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="（数据来源: winget 源）" FontSize="11" Foreground="#9AA5B1"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
