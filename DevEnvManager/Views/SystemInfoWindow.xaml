<Window x:Class="DevEnvManager.Views.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统环境信息"
        Width="640" Height="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="本机系统环境概览（仅供了解安装环境，不收集任何隐私）"
                   Foreground="{StaticResource SubTextBrush}" Margin="4,0,0,10" FontSize="12.5" />
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="6"
                Effect="{StaticResource CardShadowSm}">
            <DataGrid x:Name="InfoGrid" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="项目" Width="190" Binding="{Binding Key}" />
                    <DataGridTextColumn Header="值" Width="*" Binding="{Binding Value}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
