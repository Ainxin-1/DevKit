{
  "$comment": "Windows 开发环境管家 - 软件清单配置。新增软件时只需在此文件增加一项。category: environment(开发环境) | package_manager(包管理器)；subcategory: common(⭐常用) | uncommon(🧰不常用)。安装方式 method: winget(经 winget 安装) | bundled(随宿主自带) | official(官方命令) | manual(官方引导，不自动执行)。",
  "tools": [
    {
      "name": "Git",
      "category": "environment",
      "subcategory": "common",
      "description": "分布式版本控制",
      "detect": {
        "command": "git",
        "versionArgs": "--version",
        "versionRegex": "(\\d+\\.\\d+(\\.\\d+)?)",
        "pathHints": [
          "C:\\Program Files\\Git"
        ]
      },
      "dependencies": [],
      "install": {
        "method": "winget",
        "id": "Git.Git"
      }
    },
    {
      "name": "Python",
      "category": "environment",
      "subcategory": "common",
      "description": "Python 解释器",
      "detect": {
        "command": "python",
        "versionArgs": "--version",
        "versionRegex": "(\\d+\\.\\d+(\\.\\d+)?)",
        "minVersion": "3.8"
      },
      "dependencies": [],
      "install": {
        "method": "winget",
        "id": "Python.Python.3.12"
      }
    },
    {
      "name": "Node.js",
      "category": "environment",
      "subcategory": "common",
      "description": "JavaScript 运行时（LTS）",
      "detect": {
        "command": "node",
        "versionArgs": "--version",
        "versionRegex": "v?(\\d+\\.\\d+(\\.\\d+)?)",
        "minVersion": "20.0"
      },
      "dependencies": [],
      "install": {
        "method": "winget",
        "id": "OpenJS.NodeJS.LTS"
      }
    },
    {
      "name": "JDK",
      "category": "environment",
      "subcategory": "common",
      "description": "Java 开发工具包（Temurin 21 LTS）",
      "detect": {
        "command": "java",
        "versionArgs": "-version",
        "versionRegex": "(\\d+\\.\\d+(\\.\\d+)?)",
        "minVersion": "17.0",
        "envVar": "JAVA_HOME",
        "pathHints": [
          "C:\\Program Files\\Java",
          "C:\\Program Files\\Eclipse Adoptium"
        ]
      },
      "dependencies": [],
      "install": {
        "method": "winget",
        "id": "EclipseAdoptium.Temurin.21.JDK"
      }
    },
