<Window x:Class="DevEnvManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevEnvManager.Views"
        Title="Windows 开发环境管家"
        Icon="app.ico"
        Width="1240" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 左侧分类列表项 -->
        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Margin="4,2" Padding="12,9"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Dot" Text="●" FontSize="8" VerticalAlignment="Center"
                                           Margin="0,0,8,0" Foreground="#C9D2DE" />
                                <TextBlock Text="{Binding Title}" FontSize="13" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                <Setter TargetName="Dot" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态徽章 -->
        <DataTemplate x:Key="StatusBadge">
            <Border x:Name="Badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="#F1F3F6">
                <TextBlock x:Name="Txt" Text="{Binding StatusText}" FontSize="11.5" Foreground="#5B6573" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Installed">
                    <Setter TargetName="Badge" Property="Background" Value="#E3F2E6" />
                    <Setter TargetName="Txt" Property="Foreground" Value="#2E7D32" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NotInstalled">
                    <Setter TargetName="Badge" Property="Background" Value="#F1F3F6" />
                    <Setter TargetName="Txt" Property="Foreground" Value="#6B7280" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="VersionTooLow">
                    <Setter TargetName="Badge" Property="Background" Value="#FDECEA" />
                    <Setter TargetName="Txt" Property="Foreground" Value="#C62828" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="UpdateAvailable">
                    <Setter TargetName="Badge" Property="Background" Value="#FFF3E0" />
                    <Setter TargetName="Txt" Property="Foreground" Value="#E65100" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Detecting">
                    <Setter TargetName="Badge" Property="Background" Value="#E3F2FD" />
                    <Setter TargetName="Txt" Property="Foreground" Value="#1565C0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="DetectFailed">
                    <Setter TargetName="Badge" Property="Background" Value="#FBE9E7" />
                    <Setter TargetName="Txt" Property="Foreground" Value="#B71C1C" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部：标题 + 搜索/筛选/操作 ==================== -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="12"
                Padding="18,14" Margin="0,0,0,12" Effect="{StaticResource CardShadowSm}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Windows 开发环境管家" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="检测 · 分类 · 依赖分析 · 一键安装" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBox Grid.Column="2" Width="230" Margin="0,0,10,0" VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="搜索开发环境或包管理器（如输入 python）" />

                <ComboBox Grid.Column="3" Width="118" Margin="0,0,10,0" VerticalAlignment="Center"
                          ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedFilter}" />

                <ComboBox Grid.Column="4" Width="118" Margin="0,0,10,0" VerticalAlignment="Center"
                          ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding StatusFilter}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Padding="4,4" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="5" Content="⟳ 重新检测" Padding="16,8" VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButton}" Command="{Binding DetectCommand}" />
            </Grid>
        </Border>

        <!-- ==================== 中部：TabControl（环境管理 + 应用商店） ==================== -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                    Style="{StaticResource ModernTabControl}">
            <TabItem Header="🛠 环境管理" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧分类卡片 -->
                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="12"
                            Margin="0,0,12,0" Padding="10,12" Effect="{StaticResource CardShadowSm}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="分 类" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubTextBrush}" Margin="12,0,0,8" />
                            <ListBox ItemsSource="{Binding Categories}"
                                     SelectedItem="{Binding SelectedCategoryNode}"
                                     BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource CategoryItem}" />
                        </DockPanel>
                    </Border>

                    <!-- 右侧列表卡片 -->
                    <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="12"
                            Padding="8,8" Effect="{StaticResource CardShadowSm}">
                        <DataGrid x:Name="ToolGrid" ItemsSource="{Binding VisibleItems}"
                                  AutoGenerateColumns="False"
                                  PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="选择" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="名称" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{StaticResource SubTextBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="状态" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusBadge}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="版本" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center" FontSize="12.5" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="安装路径" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PathText}" VerticalAlignment="Center" FontSize="12"
                                                       Foreground="#4B5563" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding InstallPath}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="安装方式" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding InstallMethodText}" VerticalAlignment="Center" FontSize="12" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="依赖" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DependencyText}" VerticalAlignment="Center" FontSize="12" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="安装结果" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding InstallResult}" VerticalAlignment="Center" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallResult}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="🛒 应用商店" Style="{StaticResource ModernTabItem}">
                <views:StoreView DataContext="{Binding StoreVM, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Margin="0,6,0,0" />
            </TabItem>
        </TabControl>

        <!-- ==================== 底部：统计 + 操作 + 进度 ==================== -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <!-- 操作栏 -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16,10"
                    Effect="{StaticResource CardShadowSm}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="12" Background="{StaticResource PrimarySoftBrush}" Padding="10,4">
                            <TextBlock FontSize="12.5">
                                <Run Text="已选择 " /><Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="Bold" /><Run Text=" 项" />
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}"
                                   FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="取消选择" Padding="14,7" Margin="4,0" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearSelectionCommand}" />
                    <Button Grid.Column="2" Content="查看日志" Padding="14,7" Margin="4,0" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowLogCommand}" />
                    <Button Grid.Column="3" Content="系统信息" Padding="14,7" Margin="4,0" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowSystemInfoCommand}" />
                    <Button Grid.Column="4" Content="更新" Padding="22,9" Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButton}" Command="{Binding UpdateCommand}" />
                    <Button Grid.Column="5" Content="安装" Padding="22,9" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" />
                </Grid>
            </Border>

            <!-- 安装进度卡片 -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16,12"
                    Margin="0,10,0,0" Effect="{StaticResource CardShadowSm}"
                    Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="取消安装" Padding="12,5" Margin="12,0,0,0"
                                    Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CurrentTool}" FontWeight="SemiBold" FontSize="13.5" />
                                <TextBlock Text="　" />
                                <TextBlock Text="{Binding CurrentStage}" Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Height="7" Margin="0,9,0,7" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressValue}"
                                     IsIndeterminate="{Binding ProgressIsIndeterminate}"
                                     Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ProgressDetail}" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"
                                   TextWrapping="Wrap" MaxHeight="42" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="380" MaxHeight="150" Margin="16,0,0,0" Padding="10"
                            CornerRadius="8" Background="#FAFBFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="安装记录" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubTextBrush}" Margin="2,0,0,6" />
                            <ListBox ItemsSource="{Binding InstallHistory}" BorderThickness="0" Background="Transparent"
                                     FontSize="11.5" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
