<Window x:Class="DevKit.Views.InstallPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装计划确认"
        Width="600" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,0,12">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="安装计划确认" />
            <TextBlock Text="依赖已自动排在前方安装；已安装的依赖不会重复安装；安装命令将写入日志。"
                       Foreground="{StaticResource SubTextBrush}" Margin="0,5,0,0" FontSize="12" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="6"
                Effect="{StaticResource CardShadowSm}">
            <DataGrid x:Name="PlanGrid" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="顺序" Width="50" Binding="{Binding Order}" />
                    <DataGridTextColumn Header="软件" Width="120" Binding="{Binding ToolName}" />
                    <DataGridTextColumn Header="类型" Width="90" Binding="{Binding Kind}" />
                    <DataGridTextColumn Header="安装方式" Width="100" Binding="{Binding Method}" />
                    <DataGridTextColumn Header="原因" Width="*" Binding="{Binding Reason}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="96" Padding="0,8" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}" IsCancel="True" />
            <Button Content="✔ 确认安装" Width="128" Padding="0,9" FontWeight="SemiBold"
                    Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnConfirm" />
        </StackPanel>
    </Grid>
</Window>
