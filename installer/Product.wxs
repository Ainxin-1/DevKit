<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="DevKit"
           Manufacturer="DevKit"
           Version="0.1.0"
           Scope="perUser"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
           Language="2052">

    <!-- perUser 安装：Package Scope="perUser" 在编译期即确定单用户上下文
         （自动设置 ALLUSERS=2 + MSIINSTALLPERUSER=1），安装到 %LOCALAPPDATA%，无需 UAC。
         注意：不能用运行时 SetProperty 改 ALLUSERS——编译期仍是 perMachine，
         会与 MajorUpgrade 冲突触发 1925/1603。 -->

    <!-- 允许同版本升级，安装前先卸载旧版本；perUser 上下文下旧版同为 perUser，可静默升级无需提权 -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="已安装更新版本。"
                  Schedule="afterInstallValidate" />

    <Icon Id="AppIcon" SourceFile="app.ico" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- perUser 安装目录：%LOCALAPPDATA%\Programs\DevKit -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Programs">
        <Directory Id="AppDir" Name="DevKit">
          <Directory Id="ConfigDir" Name="config" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="DevKit" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="主程序" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="ConfigFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="AppDir">
      <Component>
        <File Source="DevKit.exe" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="app.ico" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ConfigFiles" Directory="ConfigDir">
      <Component>
        <File Source="config\tools.json" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts">
      <Component Directory="ProgramMenuDir">
        <Shortcut Id="StartMenuShortcut"
                  Name="DevKit"
                  Target="[AppDir]DevKit.exe"
                  WorkingDirectory="AppDir"
                  Icon="AppIcon" IconIndex="0" />
        <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\DevKit" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Directory="DesktopFolder">
        <Shortcut Id="DesktopShortcut"
                  Name="DevKit"
                  Target="[AppDir]DevKit.exe"
                  WorkingDirectory="AppDir"
                  Icon="AppIcon" IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\DevKit\Shortcuts" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
