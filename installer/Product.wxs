<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Windows 开发环境管家"
           Manufacturer="DevKit"
           Version="0.1.0"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
           Language="2052">

    <!-- perUser 安装：当前用户目录，无需管理员权限，快捷方式在当前用户桌面 -->
    <SetProperty Id="ALLUSERS" Value="2" Before="CostInitialize" Sequence="both" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />

    <MajorUpgrade DowngradeErrorMessage="已安装更新版本。" />

    <Icon Id="AppIcon" SourceFile="app.ico" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- perUser 安装目录：%LOCALAPPDATA%\Programs\DevKit -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Programs">
        <Directory Id="AppDir" Name="DevKit">
          <Directory Id="ConfigDir" Name="config" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="开发环境管家" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="主程序" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="ConfigFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="AppDir">
      <Component>
        <File Source="DevKit.exe" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="app.ico" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ConfigFiles" Directory="ConfigDir">
      <Component>
        <File Source="config\tools.json" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts">
      <Component Directory="ProgramMenuDir">
        <Shortcut Id="StartMenuShortcut"
                  Name="开发环境管家"
                  Target="[AppDir]DevKit.exe"
                  WorkingDirectory="AppDir"
                  Icon="AppIcon" IconIndex="0" />
        <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\DevKit" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Directory="DesktopFolder">
        <Shortcut Id="DesktopShortcut"
                  Name="开发环境管家"
                  Target="[AppDir]DevKit.exe"
                  WorkingDirectory="AppDir"
                  Icon="AppIcon" IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\DevKit\Shortcuts" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
